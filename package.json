{
  "name": "sitemap-cohort-auditor",
  "version": "0.2.2",
  "description": "Audit sitemap URL cohorts, image coverage, metadata quality, and release-to-release changes.",
  "author": "Edilec Private Limited",
  "homepage": "https://github.com/edilec/sitemap-cohort-auditor#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/edilec/sitemap-cohort-auditor.git"
  },
  "bugs": {
    "url": "https://github.com/edilec/sitemap-cohort-auditor/issues"
  },
  "type": "module",
  "bin": {
    "sitemap-cohort-auditor": "./bin/sitemap-cohort-auditor.mjs"
  },
  "scripts": {
    "audit": "node ./bin/sitemap-cohort-auditor.mjs",
    "lint": "node --check lib/audit.mjs && node --check lib/policy.mjs && node --check bin/sitemap-cohort-auditor.mjs && node --check scripts/check-links.mjs",
    "docs:check": "node ./scripts/check-links.mjs",
    "package:check": "npm pack --dry-run",
    "test": "node --test",
    "test:coverage": "node --test --experimental-test-coverage",
    "verify": "npm test && npm run docs:check && npm run package:check",
    "check": "npm run lint && npm run verify"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "bin/",
    "lib/",
    "docs/",
    "examples/",
    "README.md",
    "CHANGELOG.md",
    "CODE_OF_CONDUCT.md",
    "LICENSE",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "MAINTAINERS.md",
    "SUPPORT.md"
  ],
  "keywords": [
    "sitemap",
    "seo",
    "audit",
    "cli",
    "ci",
    "policy"
  ],
  "license": "MIT"
}
